# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hayatconnect
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/hayatconnect

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT — generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Twilio (SMS/OTP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Firebase (Push Notifications)
FCM_SERVER_KEY=

# Matching
MATCH_RADIUS_KM=15.0
MAX_DONORS_TO_NOTIFY=10
REQUEST_EXPIRY_HOURS=48
